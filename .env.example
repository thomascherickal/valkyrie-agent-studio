# Copy this file to .env (which is gitignored) and fill in the keys you use.
# The API reads .env when it starts and again on every run, so a key you paste is used without a restart.
# A variable already set in your shell wins over this file. Without any key, runs are simulated offline.

# Gemini 4 Hydrogen, the default for every request
GEMINI_API_KEY=

# Fallbacks, tried in this order when the provider before them fails:
# OpenCode (free models: big-pickle, deepseek-v4.1-flash-free, mimo-v2.6-flash-free) then OpenRouter (free models).
# OpenCode's free models need a key: without one the free tier answers HTTP 429.
OPENCODE_API_KEY=
OPENROUTER_API_KEY=

# Optional: choose the free models yourself (comma lists, tried in order)
# VALKYRIE_OPENCODE_MODELS=big-pickle,deepseek-v4.1-flash-free
# VALKYRIE_OPENROUTER_MODELS=openrouter/free

# Optional: the model() helper in Hybrid agents. Provider: gemini, ollama, openrouter or opencode.
# VALKYRIE_MODEL_PROVIDER=gemini
# VALKYRIE_MODEL_ID=

# Optional: where the step-by-step trace log is written (default: logs/ in the repo)
# VALKYRIE_LOG_DIR=
