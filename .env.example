# Copy this file to .env (which is gitignored) and fill in the keys you use.
# The API reads .env when it starts. A variable already set in your shell wins over this file.
# Without a key, runs are simulated and nothing is sent anywhere.

# Gemini 4 Hydrogen, the default for every request
GEMINI_API_KEY=

# Optional: OpenRouter and OpenCode (pick a Model ID under Design in the studio)
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
