#!/bin/sh
# Valkyrie pre-commit: METRICS.md is refreshed automatically, and NEXT-STEPS.md must be part of every commit.
# Skip once (a revert, say) with:  SKIP_TRACKING=1 git commit ...
[ -n "$SKIP_TRACKING" ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1

python3 scripts/update_metrics.py || exit 1
git add METRICS.md

# A merge commit brings in other commits' files, so only the metrics are refreshed for it.
[ -f "$(git rev-parse --git-path MERGE_HEAD)" ] && exit 0

if ! git diff --cached --name-only | grep -qx 'NEXT-STEPS.md'; then
  echo "NEXT-STEPS.md is not part of this commit." >&2
  echo "Tick what is done, add what you found, stage it, and commit again (SKIP_TRACKING=1 skips this check)." >&2
  exit 1
fi
